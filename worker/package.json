{
  "name": "remarkable-cloud-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "db:apply:local": "wrangler d1 migrations apply remarkable --local",
    "db:apply:remote": "wrangler d1 migrations apply remarkable --remote",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.4.0",
    "aws4fetch": "^1.0.20",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "typescript": "^5.7.2",
    "wrangler": "^4.56.0"
  }
}
