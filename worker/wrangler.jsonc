{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "remarkable-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"], // @cloudflare/puppeteer needs it
  "observability": { "enabled": true },

  // Template config: copy it to your own deploy setup and fill in the values
  // (README "Deploy"). The tablet syncs over workers.dev; keep workers_dev on.
  // The drive needs its own hostname behind Cloudflare Access: add
  //   "routes": [{ "pattern": "<drive host>", "custom_domain": true }]
  // and set DRIVE_HOST / ACCESS_* in your copy. Empty DRIVE_HOST = drive off.
  "workers_dev": true,

  // CLOUD_HOST: public host the device/clients reach us on. Drives the /discovery
  // responses + signed-URL host.
  // DRIVE_HOST / ACCESS_*: the drive hostname and its Cloudflare Access app.
  "vars": {
    "CLOUD_HOST": "remarkable-cloud.<your-subdomain>.workers.dev",
    "DRIVE_HOST": "",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },

  // Browser Rendering: HTML / web page -> PDF for the drive.
  "browser": { "binding": "BROWSER" },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "remarkable",
      "database_id": "<your-d1-database-id>",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "BLOBS",
      "bucket_name": "remarkable-blobs"
    }
  ],

  "durable_objects": {
    "bindings": [
      { "name": "USER_HUB", "class_name": "UserHub" }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["UserHub"]
    }
  ],

  // Rate limiters (per client IP). Applied ONLY to /token/* and /admin/* —
  // NOT to /sync/* or /blobstorage (legit sync bursts ~35 req/s). period is 10 or 60.
  "unsafe": {
    "bindings": [
      {
        "name": "RL_TOKEN",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 60, "period": 60 }
      },
      {
        "name": "RL_ADMIN",
        "type": "ratelimit",
        "namespace_id": "1002",
        "simple": { "limit": 20, "period": 60 }
      }
    ]
  }

  // Secrets (set via `wrangler secret put` for prod, `.dev.vars` for local):
  //   JWT_SECRET            - HS256 signing key for all device/user/web tokens
  //   ADMIN_TOKEN           - bearer for the temporary /admin bootstrap routes
  //   DRIVE_USERS           - JSON {"<Access email or service-token client id>": "<uid>"}
  //   R2_ACCOUNT_ID         - Cloudflare account id (for the R2 S3 endpoint)
  //   R2_ACCESS_KEY_ID      - R2 S3 API token access key (for presigning)
  //   R2_SECRET_ACCESS_KEY  - R2 S3 API token secret
  //   R2_BUCKET             - "remarkable-blobs" (S3 bucket name for presign URLs)
}
